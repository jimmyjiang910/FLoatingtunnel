FINISH
/CLEAR,NOSTART
/FILNAME,FULL02_R2
/PREP7

! ========== 几何与结构参数 ==========
R1=6.5
R2=7.5
R3=0.1235
R4=0.1235
PI=3.1415926
S2=PI*R2**2
S3=PI*R3**2
S4=PI*R4**2
BWR=1.1      !(1.1 1.3 1.5 1.7 1.9)
!管道跨长
LT1=500
LT2=1000
LT3=3000
LT4=5000
LT5=10000
LT=LT4
LS=100
N=LT/LS
HT=100
HS=40
LL=HT-HS
D0=15
D1=1
D2=1
*AFUN,DEG
TH_1=45
TH_2=90
TH_3=60      !安装角
LL=HT-HS-R2*cos(TH_3)

! ========== 波流参数 ==========
rho_water=1025
g=9.81
Cd=0.7
Cm=2.0
/INPUT,WH1,ans,D:\111AAAjxy\FloatingTunnel\APLD_MODEL\wave_cases   !注意修改绝对路径
! 检查参数是否读取成功
! *STATUS,Hwave
! *STATUS,Twave
! *STATUS,Uc


omega=2*PI/Twave
kwave=omega**2/g   !色散关系简化（近似解）
z_tunnel=-HS
att_exp=EXP(kwave*z_tunnel)
umax_surface=PI*Hwave/Twave
umax_tunnel=umax_surface*att_exp
amax_tunnel=omega*umax_tunnel
D_out=2*R2
A_mor=0.5*Cd*rho_water*D_out
B_mor=Cm*rho_water*(PI*D_out**2/4)

t_end=10*Twave       !收敛时间
dt=Twave/20          !dt=0.3
nstep=NINT(t_end/dt)
! ========== 模态与阻尼控制参数 ==========
nmode=20          ! 暂时提取前20阶模态
xi=0.05           ! 目标阻尼比5%

! ========== 建立模型 ==========
! 管体
ET,1,BEAM188
MP,EX,1,3.45e10
MP,PRXY,1,0.2
! ---- 由浮重比反算管体材料密度 ----
! 定义: BWR = 浮力/管体自重 = rho_water*S2 / (rho_pipe*S1)
! BEAM188+CTUBE 质量只由环形面积 S1 贡献；浮力按外轮廓面积 S2 计
S1=PI*(R2**2-R1**2)
rho_pipe=rho_water*S2/(BWR*S1)
*STATUS,rho_pipe
MP,DENS,1,rho_pipe
SECTYPE,1,BEAM,CTUBE,,0
SECDATA,R1,R2,20


*DO,i,1,N+1
    K,i, LS*(i-1), -HS, 0
*ENDDO
*DO,i,1,N
    L,i,i+1
*ENDDO
ALLSEL
LATT,1,,1,,,,1
LESIZE,ALL,,,D0
LMESH,ALL

! 刚臂
ET,2,BEAM188
MP,EX,2,3.45e13
MP,PRXY,2,0.2
MP,DENS,2,0
SECTYPE,2,BEAM,CSOLID,,0
SECDATA,0.1

*DO,i,1,N/2
    K,i+100, LS*(2*i-1), -HS-R2*cos(TH_3), R2*SIN(TH_3)
    K,i+200, LS*(2*i-1), -HS-R2*cos(TH_3), -R2*SIN(TH_3)
*ENDDO
*DO,i,1,N/2
    L,i+100,i+200
*ENDDO
LSEL,S,LOC,Y,-HS-0.1,-HS+0.1
LSEL,INVE
LATT,2,,2,,,,2
LESIZE,ALL,,,1
LMESH,ALL

! 缆绳1(默认斜缆45°)
ET,3,LINK180
MP,EX,3,2.10e11
MP,PRXY,3,0.3
MP,DENS,3,7850
SECTYPE,3,LINK
SECDATA,S3
SECCONTROL,,1     ! 截面3：仅受拉

*DO,i,1,N/2
    K,i+1000, LS*(2*i-1), -HT, R2*SIN(TH_3)+LL/TAN(TH_1)
    K,i+2000, LS*(2*i-1), -HT, -R2*SIN(TH_3)-LL/TAN(TH_1)
*ENDDO
*DO,i,1,N/2
    L,i+1000,i+100
    L,i+2000,i+200
*ENDDO
ALLSEL
LSEL,U,TYPE,,1,2
LATT,3,,3,,,,3
LESIZE,ALL,,,D1
LMESH,ALL

! 缆绳2(默认竖缆)
ET,4,LINK180
MP,EX,4,2.10e11
MP,PRXY,4,0.3
MP,DENS,4,7850
SECTYPE,4,LINK
SECDATA,S4
SECCONTROL,,1     ! 截面4：仅受拉

*DO,i,1,N/2
    K,i+3000, LS*(2*i-1), -HT, R2*SIN(TH_3)+LL/TAN(TH_2)
    K,i+4000, LS*(2*i-1), -HT, -R2*SIN(TH_3)-LL/TAN(TH_2)
*ENDDO
*DO,i,1,N/2
    L,i+3000,i+100
    L,i+4000,i+200
*ENDDO
ALLSEL
LSEL,U,TYPE,,1,3
LATT,4,,4,,,,4
LESIZE,ALL,,,D2
LMESH,ALL

! 边界条件
KSEL,S,,,1
KSEL,A,,,N+1
NSLK
D,ALL,ALL,0
NSEL,S,LOC,Y,-HT-1,-HT+1
D,ALL,ALL,0
ALLSEL

! 管体中心与刚臂两端建立刚性连接
ALLSEL,ALL

ET,5,MPC184
KEYOPT,5,1,1       ! 刚性梁：关联平移和转动
KEYOPT,5,2,0       ! 直接消元法

TYPE,5
MAT,2              ! 使用已有零密度材料，不增加质量

*DO,i,1,N/2
    ! 获取关键点对应的实际节点编号
    *GET,n_center,KP,2*i,ATTR,NODE
    *GET,n_side1,KP,i+100,ATTR,NODE
    *GET,n_side2,KP,i+200,ATTR,NODE

    E,n_center,n_side1
    E,n_center,n_side2
*ENDDO

ALLSEL,ALL

! ========== 生成Y、Z双向波浪力时间表 ==========
*AFUN,RAD

*DIM,time_arr,ARRAY,nstep
*DIM,FwaveY_arr,ARRAY,nstep
*DIM,FwaveZ_arr,ARRAY,nstep

*DO,i,1,nstep

    t=i*dt
    time_arr(i)=t
    phase=omega*t

    ! Airy波水质点速度：Y、Z相差90度
    vel_z=umax_tunnel*COS(phase)+Uc
    vel_y=-umax_tunnel*SIN(phase)

    ! 加速度必须由对应速度对时间求导
    acc_z=-omega*umax_tunnel*SIN(phase)
    acc_y=-omega*umax_tunnel*COS(phase)

    ! 管轴沿X，因此Y、Z速度均属于管轴法向速度
    vel_n=SQRT(vel_y**2+vel_z**2)

    ! 矢量形式Morison线荷载，单位N/m
    FwaveZ_arr(i)=A_mor*vel_n*vel_z+B_mor*acc_z
    FwaveY_arr(i)=A_mor*vel_n*vel_y+B_mor*acc_y

*ENDDO
! ========== 净浮力及管体节点信息 ==========

! 净浮力总值
! 净浮力总值：与 BWR 定义一致（净浮力 = 浮力 - 自重）
Vol_displaced=S2*LT
W_pipe=rho_pipe*g*S1*LT
Fnet_N=(BWR-1)*W_pipe
rho_steel=7850
n_bent=N-1
Lc_v=LL
Lc_i=LL/COS(TH_1*PI/180)
Wc_sub=(rho_steel-rho_water)*g*(2*S4*Lc_v+2*S3*Lc_i)*n_bent
q_buoy_static=(Fnet_N-Wc_sub)/LT
*STATUS,Wc_sub
*STATUS,q_buoy_static

! 建立管体节点组件
ESEL,S,TYPE,,1
NSLE,S
CM,TUNNEL_NODES,NODE

*GET,Nnode_tunnel,NODE,0,COUNT
Le_tunnel=LT/(Nnode_tunnel-1)

! =========================================================
! 定义管体中跨节点
! 中跨坐标：X=LT/2，Y=-HS，Z=0
! =========================================================
ALLSEL,ALL

MID_TOL=0.1

NSEL,S,LOC,X,LT/2-MID_TOL,LT/2+MID_TOL
NSEL,R,LOC,Y,-HS-MID_TOL,-HS+MID_TOL
NSEL,R,LOC,Z,-MID_TOL,MID_TOL

*GET,N_MID,NODE,0,NUM,MIN

ALLSEL,ALL

! 检查是否找到节点
*IF,N_MID,LE,0,THEN
    /COM,ERROR: N_MID WAS NOT FOUND
    /COM,CHECK LT, HS AND MID_TOL
    *ABORT
*ENDIF

FINISH

! ============================================================
! 1. 非线性静力平衡：建立净浮力作用下的预应力状态
! ============================================================
/SOLU
ANTYPE,STATIC
NLGEOM,ON
KBC,0

! 静力平衡求解控制：初始20子步，最多100子步
AUTOTS,ON
NSUBST,20,100,1
TIME,1.0

! 保存最后一个收敛点，供线性扰动模态分析使用
RESCONTROL,DEFINE,LAST,LAST
OUTRES,ALL,LAST

! 清除可能残留的节点力
ALLSEL,ALL
FDELE,ALL,ALL

! ---------- 内部管体节点：完整净浮力权重 ----------
CMSEL,S,TUNNEL_NODES
NSEL,U,LOC,X,0
NSEL,U,LOC,X,LT
F,ALL,FY,q_buoy_static*Le_tunnel

! ---------- 左端节点：半权重 ----------
CMSEL,S,TUNNEL_NODES
NSEL,R,LOC,X,0
F,ALL,FY,0.5*q_buoy_static*Le_tunnel

! ---------- 右端节点：半权重 ----------
CMSEL,S,TUNNEL_NODES
NSEL,R,LOC,X,LT
F,ALL,FY,0.5*q_buoy_static*Le_tunnel

ALLSEL,ALL
SOLVE
FINISH


! ============================================================
! 2. 基于静力平衡状态的预应力模态分析
! ============================================================
/SOLU

! 从上一静力分析的最后收敛点进行线性扰动
ANTYPE,STATIC,RESTART,,,PERTURB

! MODAL：线性扰动模态
! PARKEEP：保留位移约束，删除外部机械荷载；
! 静力应力状态仍包含在切线刚度中
PERTURB,MODAL,,,PARKEEP

! 根据静力平衡状态重新形成单元矩阵
SOLVE,ELFORM

! Block Lanczos 提取前 nmode 阶模态
MODOPT,LANB,nmode
MXPAND,nmode,,,YES
OUTRES,ALL,ALL
SOLVE

! 读取各阶模态频率，*GET得到的是Hz
*DIM,freq_hz,ARRAY,nmode
*DO,im,1,nmode
    *GET,freq_hz(im),MODE,im,FREQ
*ENDDO

! ---- 瑞利阻尼控制点自动选取 ----
fw=1/Twave                 ! 波频 Hz
ww=2*PI*fw                 ! 波圆频率
w1_modal=2*PI*freq_hz(1)

! 下限：波频低于基频时用波频，保证波频处阻尼=xi
*IF,ww,LT,w1_modal,THEN
    w_ctrl_lo=ww
*ELSE
    w_ctrl_lo=w1_modal
*ENDIF

! 上限：5倍波频以内的最高阶模态
f_hi_band=5*fw
mode_hi=1
*DO,im,1,nmode
    *IF,freq_hz(im),LE,f_hi_band,THEN
        mode_hi=im
    *ENDIF
*ENDDO
*IF,freq_hz(1),GT,f_hi_band,THEN
    w_ctrl_hi=w1_modal
*ELSE
    w_ctrl_hi=2*PI*freq_hz(mode_hi)
*ENDIF

! 安全保护：上限必须大于下限
*IF,w_ctrl_hi,LE,w_ctrl_lo,THEN
    w_ctrl_hi=2*PI*freq_hz(nmode)
*ENDIF

alpha_ray=2*xi*w_ctrl_lo*w_ctrl_hi/(w_ctrl_lo+w_ctrl_hi)
beta_ray =2*xi/(w_ctrl_lo+w_ctrl_hi)

! 阻尼曲线校核
xi_wave =alpha_ray/(2*ww)+beta_ray*ww/2
xi_3wave=alpha_ray/(2*3*ww)+beta_ray*(3*ww)/2
xi_f1   =alpha_ray/(2*w1_modal)+beta_ray*w1_modal/2

*STATUS,freq_hz
*STATUS,mode_hi
*STATUS,w_ctrl_lo
*STATUS,w_ctrl_hi
*STATUS,alpha_ray
*STATUS,beta_ray
*STATUS,xi_wave
*STATUS,xi_3wave
*STATUS,xi_f1

FINISH

! ============================================================
! 3. 完整瞬态分析
! ============================================================
/SOLU
ANTYPE,TRANS
TRNOPT,FULL
NLGEOM,ON
KBC,0

! ------------------------------------------------------------
! 3.1 瞬态分析的初始静力平衡步
! ------------------------------------------------------------
TIMINT,OFF

! 静力平衡步不需要动力阻尼
ALPHAD,0
BETAD,0

ALLSEL,ALL
FDELE,ALL,ALL

! ---------- 内部节点净浮力 ----------
CMSEL,S,TUNNEL_NODES
NSEL,U,LOC,X,0
NSEL,U,LOC,X,LT
F,ALL,FY,q_buoy_static*Le_tunnel

! ---------- 左端净浮力 ----------
CMSEL,S,TUNNEL_NODES
NSEL,R,LOC,X,0
F,ALL,FY,0.5*q_buoy_static*Le_tunnel

! ---------- 右端净浮力 ----------
CMSEL,S,TUNNEL_NODES
NSEL,R,LOC,X,LT
F,ALL,FY,0.5*q_buoy_static*Le_tunnel

ALLSEL,ALL

! ============================================================
! 静力载荷步1：净浮力在伪时间2.1内逐步施加
! TIMINT,OFF，因此这里不是实际动力时间，不产生惯性
! ============================================================
KBC,0
t_static_ramp=2.1
TIME,t_static_ramp

AUTOTS,ON
NSUBST,20,100,1

OUTRES,ERASE
OUTRES,ALL,LAST
SOLVE


! ============================================================
! 静力载荷步2：保持完整净浮力，使初速度、初加速度趋于零
! ============================================================
KBC,1
AUTOTS,OFF

t_static_hold=0.1
TIME,t_static_ramp+t_static_hold

! 至少两个子步，两个子步中的荷载和静力位移保持不变
NSUBST,2,2,2
SOLVE

! 波浪动力分析开始时对应的总时间
t_dyn0=t_static_ramp+t_static_hold


! ------------------------------------------------------------
! 3.2 开启惯性和阻尼，进入波浪动力响应
! ------------------------------------------------------------
TIMINT,ON
KBC,0

! 使用预应力模态求得的瑞利阻尼
ALPHAD,alpha_ray
BETAD,beta_ray

! 名义时间步为dt，必要时允许自动二分至dt/10
AUTOTS,ON
DELTIM,dt,dt/10,dt,OFF

OUTRES,ALL,ALL

*DO,it,1,nstep

    ! t为波浪作用开始后的相对时间
    t=time_arr(it)

    ! 实际求解时间包含前面的虚拟静力时间
    TIME,t_dyn0+t

    ! 当前Y、Z向波浪线荷载，单位N/m
    q_wave_z=FwaveZ_arr(it)
    q_wave_y=FwaveY_arr(it)

    ! Y方向总线荷载 = 恒定净浮力 + 时变竖向波浪力
    q_force_y=q_buoy_static+q_wave_y

    ! ---------- 内部管体节点 ----------
    CMSEL,S,TUNNEL_NODES
    NSEL,U,LOC,X,0
    NSEL,U,LOC,X,LT

    F,ALL,FZ,q_wave_z*Le_tunnel
    F,ALL,FY,q_force_y*Le_tunnel

    ! ---------- 左端节点 ----------
    CMSEL,S,TUNNEL_NODES
    NSEL,R,LOC,X,0

    F,ALL,FZ,0.5*q_wave_z*Le_tunnel
    F,ALL,FY,0.5*q_force_y*Le_tunnel

    ! ---------- 右端节点 ----------
    CMSEL,S,TUNNEL_NODES
    NSEL,R,LOC,X,LT

    F,ALL,FZ,0.5*q_wave_z*Le_tunnel
    F,ALL,FY,0.5*q_force_y*Le_tunnel

    ALLSEL,ALL
    SOLVE

*ENDDO

FINISH
    SOLVE

*ENDDO

FINISH
