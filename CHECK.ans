FINISH
/POST1
ALLSEL,ALL
RSYS,0
SET,LAST !最后时间
!SET,NEAR,,,,t_check !(最大响应时间)
ALLSEL,ALL

! 1. 位移云图（看极值）
/VIEW,1,0,0,1
/VUP,1,Y
/AUTO,1

PLNSOL, U, Y,0,1.0

/DIST,1,0.5,1       ! 放大约1.33倍
/REPLOT

/IMAGE,SAVE,,PNG
PLNSOL, U, Y, 0, 1.0      ! 竖向位移 → 记录 SMX
PLNSOL, U, Z, 0, 1.0      ! 横向位移 → 记录 SMN
PLNSOL, U, SUM, 0, 1.0    ! 总位移 → 记录 SMX

! 2. 管体内力云图（先选管体单元）
ESEL,S,TYPE,,1

!定义管体内力表
ETABLE,ERAS

ETABLE,MIY,SMISC,2
ETABLE,MJY,SMISC,15

ETABLE,MIZ,SMISC,3
ETABLE,MJZ,SMISC,16

ETABLE,QIY,SMISC,6
ETABLE,QJY,SMISC,19

ETABLE,QIZ,SMISC,5
ETABLE,QJZ,SMISC,18

! 弯矩图（已经定义过，直接画）
PLLS,MIY,MJY,-1           ! 绕Y轴弯矩 → 记录 SMX/SMN
PLLS,MIZ,MJZ,-1           ! 绕Z轴弯矩 → 记录 SMX/SMN

! 剪力图（已经定义过，直接画）
PLLS,QIY,QJY,-1           ! Y方向剪力 → 记录 MAX/MIN
PLLS,QIZ,QJZ,-1           ! Z方向剪力 → 记录 MAX/MIN

! 轴力图（如果需要，临时定义并画）
ETABLE,AXI_I,SMISC,1
ETABLE,AXI_J,SMISC,14
PLLS,AXI_I,AXI_J,-1       ! 轴力 → 记录 SMX

! 扭矩图（如果需要，临时定义并画）
ETABLE,MX_I,SMISC,4
ETABLE,MX_J,SMISC,17
PLLS,MX_I,MX_J,-1         ! 扭矩 → 记录 SMX



! 锚索轴力（斜缆 TYPE=3，竖缆 TYPE=4）
!斜缆
ALLSEL,ALL
ESEL,S,TYPE,,3
ETABLE,ERAS
ETABLE,CABLE_F,SMISC,1
/GRAPHICS,FULL
PLETAB,CABLE_F,NOAV
!竖缆
ALLSEL,ALL
ESEL,S,TYPE,,4
ETABLE,ERAS
ETABLE,CABLE_F,SMISC,1
/GRAPHICS,FULL
PLETAB,CABLE_F,NOAV

ALLSEL,ALL
FINISH
! =========================================================
! 中跨节点Y、Z方向位移时程图
! =========================================================
ALLSEL,ALL
FINISH
/POST26

NUMVAR,20
XVAR,1

! 变量2：中跨Y向竖向位移
NSOL,2,N_MID,U,Y,UY_MID

! 变量3：中跨Z向横向位移
NSOL,3,N_MID,U,Z,UZ_MID

/GFORMAT,DEFA
/GROPT,DIG1,4
/GROPT,DIG2,6

/GRID,1
/AXLAB,X,Time (s)
/AXLAB,Y,Displacement (m)
/TITLE,Midspan Y and Z Displacement Time History

PLVAR,2,3

! ========== 自动捕捉稳态波峰 ==========
! 1. 设定分析范围：跳过前 2.2 秒，只看后面的情况
TIMERANGE, 2.2, t_end   !  t_end 是总时长（比如60）

! 2. 提取变量 2（Y向位移）在稳定段的最大值和对应的时间
*GET, U_MAX, VARI, 2, EXTREM, VMAX
*GET, T_MAX, VARI, 2, EXTREM, TMAX

! 3. 在屏幕上打印结果
*STATUS, U_MAX
*STATUS, T_MAX

! ================== 绘制最大变形云图 ==================
/POST1
! 读取最大时刻
SET, NEAR, , , , T_MAX

! 画总位移云图
PLNSOL, U, SUM, 0, 1.0 