FINISH
/CLEAR,NOSTART
/FILNAME,FULL02_R2
/PREP7

! ========== 几何与结构参数 ==========
R1=6.5
R2=7.5
R3=0.1235
R4=0.1235
PI=3.1415926
S2=PI*R2**2
S3=PI*R3**2
S4=PI*R4**2
BWR=1.1      !(1.1 1.3 1.5 1.7 1.9)
LT=4800
LS=100
N=LT/LS
HT=100
HS=40
LL=HT-HS
D0=15
D1=1
D2=1
*AFUN,DEG
TH=45

! ========== 波流参数 ==========
rho_water=1025
g=9.81
Cd=0.7
Cm=2.0
Hwave=3.0
Twave=6.0
Uc=0.0

omega=2*PI/Twave
kwave=omega**2/g   !色散关系简化（近似解）
z_tunnel=-HS
att_exp=EXP(kwave*z_tunnel)
umax_surface=PI*Hwave/Twave
umax_tunnel=umax_surface*att_exp
amax_tunnel=omega*umax_tunnel
D_out=2*R2
A_mor=0.5*Cd*rho_water*D_out
B_mor=Cm*rho_water*(PI*D_out**2/4)

t_end=10*Twave       !收敛时间
dt=Twave/20
nstep=NINT(t_end/dt)
! ========== 模态与阻尼控制参数 ==========
nmode=20          ! 暂时提取前20阶模态
mode_low=1        ! 低频目标模态，暂定第1阶
mode_high=2       ! 高频目标模态，暂定第2阶
xi=0.05           ! 目标阻尼比5%

! ========== 建立模型 ==========
! 管体
ET,1,BEAM188
MP,EX,1,3.45e10
MP,PRXY,1,0.2
MP,DENS,1,2550
SECTYPE,1,BEAM,CTUBE,,0
SECDATA,R1,R2,20

*DO,i,1,N+1
    K,i, LS*(i-1), -HS, 0
*ENDDO
*DO,i,1,N
    L,i,i+1
*ENDDO
ALLSEL
LATT,1,,1,,,,1
LESIZE,ALL,,,D0
LMESH,ALL

! 刚臂
ET,2,BEAM188
MP,EX,2,3.45e13
MP,PRXY,2,0.2
MP,DENS,2,0
SECTYPE,2,BEAM,CSOLID,,0
SECDATA,0.1

*DO,i,1,N/2
    K,i+100, LS*(2*i-1), -HS, R2
    K,i+200, LS*(2*i-1), -HS, -R2
*ENDDO
*DO,i,1,N/2
    L,2*i,i+200
    L,2*i,i+100
*ENDDO
LSEL,S,LOC,Z,-1,1
LSEL,INVE
LATT,2,,2,,,,2
LESIZE,ALL,,,1
LMESH,ALL

! 斜缆
ET,3,LINK180
MP,EX,3,2.10e11
MP,PRXY,3,0.3
MP,DENS,3,7850
SECTYPE,3,LINK
SECDATA,S3

*DO,i,1,N/2
    K,i+1000, LS*(2*i-1), -HT, R2+LL/TAN(TH)
    K,i+2000, LS*(2*i-1), -HT, -R2-LL/TAN(TH)
*ENDDO
*DO,i,1,N/2
    L,i+1000,i+100
    L,i+2000,i+200
*ENDDO
ALLSEL
LSEL,U,TYPE,,1,2
LATT,3,,3,,,,3
LESIZE,ALL,,,D1
LMESH,ALL

! 竖缆
ET,4,LINK180
MP,EX,4,2.10e11
MP,PRXY,4,0.3
MP,DENS,4,7850
SECTYPE,4,LINK
SECDATA,S4

*DO,i,1,N/2
    K,i+3000, LS*(2*i-1), -HT, R2
    K,i+4000, LS*(2*i-1), -HT, -R2
*ENDDO
*DO,i,1,N/2
    L,i+3000,i+100
    L,i+4000,i+200
*ENDDO
ALLSEL
LSEL,U,TYPE,,1,3
LATT,4,,4,,,,4
LESIZE,ALL,,,D2
LMESH,ALL

! 边界条件
KSEL,S,,,1
KSEL,A,,,N+1
NSLK
D,ALL,ALL,0
NSEL,S,LOC,Y,-HT-1,-HT+1
D,ALL,ALL,0
ALLSEL

! ========== 生成Y、Z双向波浪力时间表 ==========
*AFUN,RAD

*DIM,time_arr,ARRAY,nstep
*DIM,FwaveY_arr,ARRAY,nstep
*DIM,FwaveZ_arr,ARRAY,nstep

*DO,i,1,nstep

    t=i*dt
    time_arr(i)=t
    phase=omega*t

    ! Airy波水质点速度：Y、Z相差90度
    vel_z=umax_tunnel*COS(phase)+Uc
    vel_y=-umax_tunnel*SIN(phase)

    ! 加速度必须由对应速度对时间求导
    acc_z=-omega*umax_tunnel*SIN(phase)
    acc_y=-omega*umax_tunnel*COS(phase)

    ! 管轴沿X，因此Y、Z速度均属于管轴法向速度
    vel_n=SQRT(vel_y**2+vel_z**2)

    ! 矢量形式Morison线荷载，单位N/m
    FwaveZ_arr(i)=A_mor*vel_n*vel_z+B_mor*acc_z
    FwaveY_arr(i)=A_mor*vel_n*vel_y+B_mor*acc_y

*ENDDO
! ========== 净浮力及管体节点信息 ==========

! 净浮力总值
Vol_displaced=S2*LT
Fnet_N=(BWR-1)*rho_water*g*Vol_displaced
q_buoy_static=Fnet_N/LT

! 建立管体节点组件
ESEL,S,TYPE,,1
NSLE,S
CM,TUNNEL_NODES,NODE

*GET,Nnode_tunnel,NODE,0,COUNT
Le_tunnel=LT/(Nnode_tunnel-1)

! =========================================================
! 定义管体中跨节点
! 中跨坐标：X=LT/2，Y=-HS，Z=0
! =========================================================
ALLSEL,ALL

MID_TOL=0.1

NSEL,S,LOC,X,LT/2-MID_TOL,LT/2+MID_TOL
NSEL,R,LOC,Y,-HS-MID_TOL,-HS+MID_TOL
NSEL,R,LOC,Z,-MID_TOL,MID_TOL

*GET,N_MID,NODE,0,NUM,MIN

ALLSEL,ALL

! 检查是否找到节点
*IF,N_MID,LE,0,THEN
    /COM,ERROR: N_MID WAS NOT FOUND
    /COM,CHECK LT, HS AND MID_TOL
    *ABORT
*ENDIF

FINISH

! ============================================================
! 1. 非线性静力平衡：建立净浮力作用下的预应力状态
! ============================================================
/SOLU
ANTYPE,STATIC
NLGEOM,ON
KBC,0

! 静力平衡求解控制：初始20子步，最多100子步
AUTOTS,ON
NSUBST,20,100,1
TIME,1.0

! 保存最后一个收敛点，供线性扰动模态分析使用
RESCONTROL,DEFINE,LAST,LAST
OUTRES,ALL,LAST

! 清除可能残留的节点力
ALLSEL,ALL
FDELE,ALL,ALL

! ---------- 内部管体节点：完整净浮力权重 ----------
CMSEL,S,TUNNEL_NODES
NSEL,U,LOC,X,0
NSEL,U,LOC,X,LT
F,ALL,FY,q_buoy_static*Le_tunnel

! ---------- 左端节点：半权重 ----------
CMSEL,S,TUNNEL_NODES
NSEL,R,LOC,X,0
F,ALL,FY,0.5*q_buoy_static*Le_tunnel

! ---------- 右端节点：半权重 ----------
CMSEL,S,TUNNEL_NODES
NSEL,R,LOC,X,LT
F,ALL,FY,0.5*q_buoy_static*Le_tunnel

ALLSEL,ALL
SOLVE
FINISH


! ============================================================
! 2. 基于静力平衡状态的预应力模态分析
! ============================================================
/SOLU

! 从上一静力分析的最后收敛点进行线性扰动
ANTYPE,STATIC,RESTART,,,PERTURB

! MODAL：线性扰动模态
! PARKEEP：保留位移约束，删除外部机械荷载；
! 静力应力状态仍包含在切线刚度中
PERTURB,MODAL,,,PARKEEP

! 根据静力平衡状态重新形成单元矩阵
SOLVE,ELFORM

! Block Lanczos 提取前 nmode 阶模态
MODOPT,LANB,nmode
MXPAND,nmode,,,YES
OUTRES,ALL,ALL
SOLVE

! 读取各阶模态频率，*GET得到的是Hz
*DIM,freq_hz,ARRAY,nmode
*DO,im,1,nmode
    *GET,freq_hz(im),MODE,im,FREQ
*ENDDO

! 输出频率数组，便于检查
*STATUS,freq_hz

! 选择两个目标模态频率
freq_low_hz=freq_hz(mode_low)
freq_high_hz=freq_hz(mode_high)

! Hz转换为圆频率 rad/s
omega_low=2*PI*freq_low_hz
omega_high=2*PI*freq_high_hz

! 两频点瑞利阻尼系数
alpha_ray=2*xi*omega_low*omega_high/(omega_low+omega_high)
beta_ray=2*xi/(omega_low+omega_high)

*STATUS,omega_low
*STATUS,omega_high
*STATUS,alpha_ray
*STATUS,beta_ray

FINISH


! ============================================================
! 3. 完整瞬态分析
! ============================================================
/SOLU
ANTYPE,TRANS
TRNOPT,FULL
NLGEOM,ON
KBC,0

! ------------------------------------------------------------
! 3.1 瞬态分析的初始静力平衡步
! ------------------------------------------------------------
TIMINT,OFF

! 静力平衡步不需要动力阻尼
ALPHAD,0
BETAD,0

ALLSEL,ALL
FDELE,ALL,ALL

! ---------- 内部节点净浮力 ----------
CMSEL,S,TUNNEL_NODES
NSEL,U,LOC,X,0
NSEL,U,LOC,X,LT
F,ALL,FY,q_buoy_static*Le_tunnel

! ---------- 左端净浮力 ----------
CMSEL,S,TUNNEL_NODES
NSEL,R,LOC,X,0
F,ALL,FY,0.5*q_buoy_static*Le_tunnel

! ---------- 右端净浮力 ----------
CMSEL,S,TUNNEL_NODES
NSEL,R,LOC,X,LT
F,ALL,FY,0.5*q_buoy_static*Le_tunnel

ALLSEL,ALL

! ============================================================
! 静力载荷步1：净浮力在伪时间2.1内逐步施加
! TIMINT,OFF，因此这里不是实际动力时间，不产生惯性
! ============================================================
KBC,0
t_static_ramp=2.1
TIME,t_static_ramp

AUTOTS,ON
NSUBST,20,100,1

OUTRES,ERASE
OUTRES,ALL,LAST
SOLVE


! ============================================================
! 静力载荷步2：保持完整净浮力，使初速度、初加速度趋于零
! ============================================================
KBC,1
AUTOTS,OFF

t_static_hold=0.1
TIME,t_static_ramp+t_static_hold

! 至少两个子步，两个子步中的荷载和静力位移保持不变
NSUBST,2,2,2
SOLVE

! 波浪动力分析开始时对应的总时间
t_dyn0=t_static_ramp+t_static_hold


! ------------------------------------------------------------
! 3.2 开启惯性和阻尼，进入波浪动力响应
! ------------------------------------------------------------
TIMINT,ON
KBC,0

! 使用预应力模态求得的瑞利阻尼
ALPHAD,alpha_ray
BETAD,beta_ray

! 名义时间步为dt，必要时允许自动二分至dt/10
AUTOTS,ON
DELTIM,dt,dt/10,dt,OFF

OUTRES,ALL,ALL

*DO,it,1,nstep

    ! t为波浪作用开始后的相对时间
    t=time_arr(it)

    ! 实际求解时间包含前面的虚拟静力时间
    TIME,t_dyn0+t

    ! 当前Y、Z向波浪线荷载，单位N/m
    q_wave_z=FwaveZ_arr(it)
    q_wave_y=FwaveY_arr(it)

    ! Y方向总线荷载 = 恒定净浮力 + 时变竖向波浪力
    q_force_y=q_buoy_static+q_wave_y

    ! ---------- 内部管体节点 ----------
    CMSEL,S,TUNNEL_NODES
    NSEL,U,LOC,X,0
    NSEL,U,LOC,X,LT

    F,ALL,FZ,q_wave_z*Le_tunnel
    F,ALL,FY,q_force_y*Le_tunnel

    ! ---------- 左端节点 ----------
    CMSEL,S,TUNNEL_NODES
    NSEL,R,LOC,X,0

    F,ALL,FZ,0.5*q_wave_z*Le_tunnel
    F,ALL,FY,0.5*q_force_y*Le_tunnel

    ! ---------- 右端节点 ----------
    CMSEL,S,TUNNEL_NODES
    NSEL,R,LOC,X,LT

    F,ALL,FZ,0.5*q_wave_z*Le_tunnel
    F,ALL,FY,0.5*q_force_y*Le_tunnel

    ALLSEL,ALL
    SOLVE

*ENDDO

FINISH